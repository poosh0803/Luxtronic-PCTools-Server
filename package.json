{
  "name": "luxtronic-pctools-server",
  "version": "0.1.0",
  "description": "Luxtronic PCTools server: ingests PC hardware test telemetry, evaluates pass/fail against config, serves a live dashboard and PDF reports.",
  "private": true,
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node db/migrate.js",
    "seed:technician": "node scripts/create-technician.js",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "chart.js": "^4.4.4"
  },
  "engines": {
    "node": ">=18"
  }
}
