# Copy to .env for local dev. Production values (LAN box) are set in the pm2 environment,
# not committed here.

# HTTP port the Express app + WebSocket server listen on.
PORT=7777

# PostgreSQL connection. Production runs its own instance on port 5434 (see PROJECT_PLAN.md
# section 5) separate from the other Luxtronic services' Postgres on 5432/5433. Local dev
# defaults to a plain localhost Postgres on the standard port 5432 -- change to 5434 if you're
# running a local instance that mirrors prod exactly.
DATABASE_URL=postgres://luxtronic_user:luxtronic_password@localhost:5432/luxtronic_pctools

# Path to the thresholds/durations config file (CONTRACT.md section 3). Defaults to
# config/default.json relative to the repo root if unset.
CONFIG_PATH=config/default.json

# Where uploaded app packages/icons are stored (defaults to data/apps in the repo root), and the
# largest single upload accepted, in MB.
APPS_DIR=data/apps
MAX_APP_UPLOAD_MB=2048
